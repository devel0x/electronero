# If using Google Sheets: File -> Share -> Publish to the web -> Link -> CSV
# Example:
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/XXXXX/export?format=csv

# Or use local CSV
CSV_PATH=data/leaderboard.csv

# Cache refresh interval (seconds)
CACHE_TTL_SECONDS=30

# Ambassador reward pool address on the ITC network

AMBASSADOR_POOL_ADDRESS=itc1q6fhuphrf7qw8eyazahlr93fm0mhrl66rz0apcg1

# If interchained-cli isn’t on PATH:
INTERCHAINED_CLI=C:\Users\Interchained\Desktop\projects\interchained-development\ambassadors\fastapi-ambassador-leaderboard\interchained-cli

# If the pool address lives in a dedicated wallet you’ve loaded:
RPC_WALLET=ambassador_pool
CACHE_TTL_SECONDS=15
CLI_TIMEOUT=6.0
RANK_MODE=competition   # or: dense
